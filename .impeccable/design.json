      "css": ".ds-nav{font-family:var(--font-body,Outfit,'Noto Sans Devanagari',sans-serif);display:flex;flex-direction:column;gap:5px}.ds-nav a{display:flex;align-items:center;gap:10px;padding:12px 14px;min-height:44px;border-radius:9px;font-size:14px;color:var(--muted,#626266);text-decoration:none}.ds-nav a:hover{background:var(--background,#f7f7f7);color:var(--foreground,#19191b)}.ds-nav a[aria-current=page]{background:var(--accent-soft,#fff0ed);color:var(--accent,#b83b2f);font-weight:600}.ds-nav a:focus-visible{outline:3px solid var(--accent,#b83b2f);outline-offset:4px;}"
