      "name": "Studio Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Monochrome studio action with coral keyboard focus.",
      "html": "<button class=\"ds-primary\">Save version</button>",
      "css": ".ds-primary{font-family:var(--font-body,Outfit,'Noto Sans Devanagari',sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:11px 20px;border:0;border-radius:9px;font-size:14px;font-weight:600;line-height:1.3;cursor:pointer;transition:background .2s var(--ease,cubic-bezier(.16,1,.3,1));background:var(--foreground,#19191b);color:var(--surface,#fff)}.ds-primary:hover{background:color-mix(in srgb,var(--foreground,#19191b) 85%,var(--surface,#fff))}.ds-primary:focus-visible{outline:3px solid var(--accent,#b83b2f);outline-offset:4px;}.ds-primary:active{transform:translateY(1px)}.ds-primary:disabled{opacity:.55;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}.ds-primary:active{transform:none}}"
    },
    {
      "name": "Studio Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Surface action with a fine inset boundary.",
