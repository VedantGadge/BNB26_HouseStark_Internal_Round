      "css": ".ds-secondary{font-family:var(--font-body,Outfit,'Noto Sans Devanagari',sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:11px 20px;border:0;border-radius:9px;font-size:14px;font-weight:600;line-height:1.3;cursor:pointer;transition:background .2s var(--ease,cubic-bezier(.16,1,.3,1));background:var(--surface,#fff);color:var(--foreground,#19191b);box-shadow:inset 0 0 0 1px var(--border,#dedee0)}.ds-secondary:hover{background:var(--background,#f7f7f7)}.ds-secondary:focus-visible{outline:3px solid var(--accent,#b83b2f);outline-offset:4px;}.ds-secondary:active{transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}.ds-secondary:active{transform:none}}"
    },
