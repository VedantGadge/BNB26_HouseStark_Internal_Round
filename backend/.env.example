# Runtime
ENVIRONMENT=development
API_PREFIX=/v1
CORS_ORIGINS=http://localhost:3000
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=120
# Optional override; default is the pinned imageio-ffmpeg executable.
# FFMPEG_BINARY=/path/to/full/ffmpeg
EDIT_RENDER_TIMEOUT_SECONDS=300
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_VISION_SAMPLE_INTERVAL_SECONDS=30
GROQ_VISION_MAX_FRAMES=2
GROQ_VISION_MAX_COMPLETION_TOKENS=256

# Configure these before connecting feature routes to providers.
DATABASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AUTH_JWKS_URL=
AUTH_AUDIENCE=
AUTH_ISSUER=
# Set false only for local/demo Swagger testing; production must keep this true.
AUTH_REQUIRED=true

# Read-only YouTube account connection and analytics sync.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/youtube/callback
# A persistent Fernet key. Generate once; do not replace it on every server start.
YOUTUBE_TOKEN_ENCRYPTION_KEY=
# Enables lookup of current public, lifetime views, likes and comments by URL.
# Restrict this Google API key to the YouTube Data API v3.
YOUTUBE_PUBLIC_API_KEY=

# OpenRouter is the backend-only LLM gateway. Free-only routing is enabled for development.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=google/gemini-3.8-flash
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_FREE_ONLY=false
OPENROUTER_REQUIRE_STRUCTURED_OUTPUT=true
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_OUTPUT_TOKENS=8192
# Reserve the bounded token budget for usable structured output.
OPENROUTER_REASONING_EFFORT=low
# Script generation uses two calls, with a third for an optional revision.
OPENROUTER_MAX_CALLS_PER_OPERATION=4
OPENROUTER_MAX_FALLBACK_MODELS=2
